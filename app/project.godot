config_version=5

[application]
config/name="Pet3D"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[display]
window/size/viewport_width=480
window/size/viewport_height=560
window/size/borderless=true
window/size/always_on_top=true
window/size/transparent=true
window/size/no_focus=true
window/per_pixel_transparency/allowed=true
window/stretch/mode="disabled"
window/subwindows/embed_subwindows=false

[editor_plugins]
enabled=PackedStringArray("res://addons/vrm/plugin.cfg", "res://addons/mtoon/plugin.cfg")

[rendering]
renderer/rendering_method="mobile"
rendering_device/driver.windows="d3d12"
viewport/transparent_background=true
environment/defaults/default_clear_color=Color(0, 0, 0, 0)
textures/default_filters/use_nearest_mipmap_filter=false

[debug]
file_logging/enable_file_logging=true
file_logging/log_path="user://logs/app.log"
file_logging/max_log_files=3
