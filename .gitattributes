# 默认按文本处理并使用 LF，避免 Windows 下整文件 diff
* text=auto eol=lf

# Windows 脚本保留 CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Godot 文本资源
*.gd      text eol=lf
*.tscn    text eol=lf
*.tres    text eol=lf
*.godot   text eol=lf
*.import  text eol=lf
*.cfg     text eol=lf

# 配置与源码
*.json    text eol=lf
*.md      text eol=lf
*.py      text eol=lf
*.yml     text eol=lf
*.sh      text eol=lf

# 二进制：不做行尾转换，不尝试合并
*.vrm     binary
*.glb     binary
*.gltf    binary
*.fbx     binary
*.blend   binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.wav     binary
*.ogg     binary
*.mp3     binary
*.dll     binary
*.exe     binary
*.pck     binary
*.scn     binary
*.ctex    binary
*.res     binary
*.pdb     binary
