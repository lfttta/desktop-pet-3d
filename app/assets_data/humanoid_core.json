{
  "schema_version": 1,
  "id": "humanoid_core",
  "version": 1,
  "actions": {
    "idle": {
      "mode": "loop",
      "source": "Idle.fbx",
      "blend_seconds": 0.15,
      "root_motion": "preserve"
    },
    "walk": {
      "mode": "loop",
      "source": "Walking.fbx",
      "blend_seconds": 0.15,
      "root_motion": "vertical_only"
    },
    "turn": {
      "mode": "once",
      "source": "Idle.fbx",
      "blend_seconds": 0.12,
      "root_motion": "none",
      "derived": "turn_step",
      "heading_degrees": 180
    },
    "wave": {
      "mode": "once",
      "source": "Waving.fbx",
      "blend_seconds": 0.15,
      "root_motion": "preserve"
    },
    "pickup": {
      "mode": "hold",
      "source": "Idle.fbx",
      "blend_seconds": 0.12,
      "root_motion": "none",
      "derived": "suspended"
    },
    "fall": {
      "mode": "hold",
      "source": "Falling.fbx",
      "blend_seconds": 0.08,
      "root_motion": "none"
    },
    "recover": {
      "mode": "once",
      "source": "Idle.fbx",
      "blend_seconds": 0.12,
      "root_motion": "vertical_only",
      "derived": "landing_cushion"
    }
  }
}
